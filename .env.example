# Database
DATABASE_URL=mongodb://localhost:27017/your-database-name
PAYLOAD_DB_URL=mongodb://localhost:27017/your-database-name

# Server Configuration
PORT=3002
CORS_ORIGIN=http://localhost:5173

# Payload CMS
PAYLOAD_SECRET=your-secret-key-here
PAYLOAD_BUCKET=your-bucket-name
PAYLOAD_BUCKET_REGION=ap-south-1
PAYLOAD_BUCKET_ACCESS_KEY=your-access-key
PAYLOAD_BUCKET_SECRET_KEY=your-secret-key

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Zoho CRM
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# API
API_BASE_URL=http://localhost:3002

# OneSignal
ONESIGNAL_APP_API_KEY=your-onesignal-api-key

# WhatsApp
WHATSAPP_TEST_NUMBER_SECRET=your-test-number
WHATSAPP_LICENCE_NUMBER_SECRET=your-licence-number
WHATSAPP_API_KEY_SECRET=your-whatsapp-api-key

# Public Environment Variables (accessible in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Vite Environment Variables (for Vite projects)
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
VITE_API_BASE_URL=http://localhost:3002
VITE_ZOHO_CLIENT_ID=your-zoho-client-id
